{"summary": "Implemented vector clocks, Merkle trees, and an anti-entropy reconciler for GossipMesh P2P nodes in gossipmesh/p2p/vector_clock.py and gossipmesh/p2p/reconciler.py, along with robust unit tests in tests/p2p/test_reconciler.py.", "files": [{"path": "gossipmesh/p2p/__init__.py", "content": "from gossipmesh.p2p.vector_clock import VectorClock\nfrom gossipmesh.p2p.reconciler import MerkleNode, MerkleTree, AntiEntropyReconciler\n"}, {"path": "gossipmesh/p2p/vector_clock.py", "content": "import json\nfrom typing import Dict, Any\n\nclass VectorClock:\n    def __init__(self, clock: Dict[str, int] = None):\n        self.clock: Dict[str, int] = dict(clock) if clock else {}\n\n    def increment(self, node_id: str) -> 'VectorClock':\n        self.clock[node_id] = self.clock.get(node_id, 0) + 1\n        return self\n\n    def update(self, other: 'VectorClock') -> 'VectorClock':\n        for node_id, val in other.clock.items():\n            self.clock[node_id] = max(self.clock.get(node_id, 0), val)\n        return self\n\n    def compare(self, other: 'VectorClock') -> str:\n        self_keys = set(self.clock.keys())\n        other_keys = set(other.clock.keys())\n        all_keys = self_keys.union(other_keys)\n\n        self_le_other = True\n        other_le_self = True\n\n        for k in all_keys:\n            s_val = self.clock.get(k, 0)\n            o_val = other.clock.get(k, 0)\n            if s_val > o_val:\n                other_le_self = False\n            if s_val < o_val:\n                self_le_other = False\n\n        if self.clock == other.clock:\n            return \"EQUAL\"\n        elif self_le_other:\n            return \"BEFORE\"\n        elif other_le_self:\n            return \"AFTER\"\n        else:\n            return \"CONCURRENT\"\n\n    def to_dict(self) -> Dict[str, int]:\n        return dict(self.clock)\n\n    @classmethod\n    def from_dict(cls, data: Dict[str, int]) -> 'VectorClock':\n        return cls(data)\n\n    def __repr__(self) -> str:\n        return f\"VectorClock({self.clock})\"\n"}, {"path": "gossipmesh/p2p/reconciler.py", "content": "import hashlib\nimport json\nfrom typing import Dict, List, Tuple, Any, Optional\nfrom gossipmesh.p2p.vector_clock import VectorClock\n\nclass MerkleNode:\n    def __init__(self, key: str, value_hash: str, left: Optional['MerkleNode'] = None, right: Optional['MerkleNode'] = None):\n        self.key = key\n        self.value_hash = value_hash\n        self.left = left\n        self.right = right\n        self.hash = self._compute_hash()\n\n    def _compute_hash(self) -> str:\n        hasher = hashlib.sha256()\n        hasher.update(self.key.encode('utf-8'))\n        hasher.update(self.value_hash.encode('utf-8'))\n        if self.left:\n            hasher.update(self.left.hash.encode('utf-8'))\n        if self.right:\n            hasher.update(self.right.hash.encode('utf-8'))\n        return hasher.hexdigest()\n\nclass MerkleTree:\n    def __init__(self, data: Dict[str, str]):\n        self.root = self._build_tree(sorted(data.items()))\n\n    def _build_tree(self, items: List[Tuple[str, str]]) -> Optional[MerkleNode]:\n        if not items:\n            return None\n        if len(items) == 1:\n            k, v = items[0]\n            val_hash = hashlib.sha256(v.encode('utf-8')).hexdigest()\n            return MerkleNode(k, val_hash)\n        \n        mid = len(items) // 2\n        left_node = self._build_tree(items[:mid])\n        right_node = self._build_tree(items[mid:])\n        \n        combined_key = items[mid][0]\n        hasher = hashlib.sha256()\n        if left_node:\n            hasher.update(left_node.hash.encode('utf-8'))\n        if right_node:\n            hasher.update(right_node.hash.encode('utf-8'))\n        \n        return MerkleNode(combined_key, hasher.hexdigest(), left=left_node, right=right_node)\n\n    def get_root_hash(self) -> str:\n        return self.root.hash if self.root else hashlib.sha256(b\"empty\").hexdigest()\n\nclass AntiEntropyReconciler:\n    def __init__(self, node_id: str):\n        self.node_id = node_id\n        self.vector_clock = VectorClock({node_id: 0})\n        self.store: Dict[str, str] = {}\n\n    def set_state(self, key: str, value: str):\n        self.store[key] = value\n        self.vector_clock.increment(self.node_id)\n\n    def get_merkle_tree(self) -> MerkleTree:\n        return MerkleTree(self.store)\n\n    def reconcile(self, peer_id: str, peer_vc_dict: Dict[str, int], peer_root_hash: str) -> str:\n        peer_vc = VectorClock(peer_vc_dict)\n        comparison = self.vector_clock.compare(peer_vc)\n        if comparison == \"EQUAL\" or comparison == \"AFTER\":\n            return \"NO_SYNC_NEEDED\"\n        elif comparison == \"BEFORE\":\n            return \"PULL_FROM_PEER\"\n        else:\n            return \"EXCHANGE_MERKLE\"\n\n    def find_differences(self, peer_store: Dict[str, str]) -> List[str]:\n        diffs = []\n        all_keys = set(self.store.keys()).union(set(peer_store.keys()))\n        for k in all_keys:\n            if self.store.get(k) != peer_store.get(k):\n                diffs.append(k)\n        return diffs\n"}, {"path": "tests/p2p/test_reconciler.py", "content": "import unittest\nfrom gossipmesh.p2p.vector_clock import VectorClock\nfrom gossipmesh.p2p.reconciler import MerkleTree, AntiEntropyReconciler\n\nclass TestVectorClock(unittest.TestCase):\n    def test_vector_clock_operations(self):\n        vc1 = VectorClock({\"nodeA\": 1})\n        vc2 = VectorClock({\"nodeA\": 2})\n        self.assertEqual(vc1.compare(vc2), \"BEFORE\")\n        self.assertEqual(vc2.compare(vc1), \"AFTER\")\n        \n        vc3 = VectorClock({\"nodeA\": 1, \"nodeB\": 1})\n        vc4 = VectorClock({\"nodeA\": 1, \"nodeB\": 2})\n        self.assertEqual(vc3.compare(vc4), \"BEFORE\")\n        \n        vc5 = VectorClock({\"nodeA\": 2, \"nodeB\": 1})\n        vc6 = VectorClock({\"nodeA\": 1, \"nodeB\": 2})\n        self.assertEqual(vc5.compare(vc6), \"CONCURRENT\")\n\nclass TestMerkleTreeAndReconciler(unittest.TestCase):\n    def test_merkle_tree_hashing(self):\n        data1 = {\"a\": \"1\", \"b\": \"2\"}\n        data2 = {\"a\": \"1\", \"b\": \"2\"}\n        data3 = {\"a\": \"1\", \"b\": \"3\"}\n\n        tree1 = MerkleTree(data1)\n        tree2 = MerkleTree(data2)\n        tree3 = MerkleTree(data3)\n\n        self.assertEqual(tree1.get_root_hash(), tree2.get_root_hash())\n        self.assertNotEqual(tree1.get_root_hash(), tree3.get_root_hash())\n\n    def test_reconciler_workflow(self):\n        rec1 = AntiEntropyReconciler(\"node1\")\n        rec2 = AntiEntropyReconciler(\"node2\")\n\n        rec1.set_state(\"key1\", \"val1\")\n        tree1 = rec1.get_merkle_tree()\n\n        action = rec2.reconcile(\"node1\", rec1.vector_clock.to_dict(), tree1.get_root_hash())\n        self.assertEqual(action, \"PULL_FROM_PEER\")\n\n        rec2.set_state(\"key1\", \"val1\")\n        rec1.set_state(\"key2\", \"val2\")\n        rec2.set_state(\"key2\", \"val3\")\n\n        action2 = rec1.reconcile(\"node2\", rec2.vector_clock.to_dict(), rec2.get_merkle_tree().get_root_hash())\n        self.assertEqual(action2, \"EXCHANGE_MERKLE\")\n\n        diffs = rec1.find_differences(rec2.store)\n        self.assertIn(\"key2\", diffs)\n\nif __name__ == \"__main\":\n    unittest.main()\n"}]}
