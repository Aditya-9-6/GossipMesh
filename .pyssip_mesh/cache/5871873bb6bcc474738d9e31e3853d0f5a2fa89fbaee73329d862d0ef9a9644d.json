{"summary": "Implemented zero-allocation memoryview parsing and packet deserialization pipeline in gossipmesh/p2p/parser.py, integrated into gossipmesh/p2p/transport.py socket reader, and added robust test coverage in tests/test_transport_parser.py.", "files": [{"path": "gossipmesh/p2p/parser.py", "content": "import struct\nfrom typing import Tuple, Dict, Any\n\nclass ZeroCopyPacketParser:\n    \"\"\"Zero-copy parser for gossip wire packets using memoryview and struct unpacking.\"\"\"\n    \n    HEADER_FORMAT = \"!BI\"  # Magic byte (1), Payload length (4)\n    HEADER_SIZE = struct.calcsize(HEADER_FORMAT)\n    MAGIC_BYTE = 0x47  # 'G'\n\n    @staticmethod\n    def parse_header(buffer: memoryview) -> Tuple[int, int]:\n        \"\"\"Parses packet header without allocating new byte strings.\"\"\"\n        if len(buffer) < ZeroCopyPacketParser.HEADER_SIZE:\n            raise ValueError(\"Buffer too small for packet header\")\n        \n        magic, length = struct.unpack_from(ZeroCopyPacketParser.HEADER_FORMAT, buffer, 0)\n        if magic != ZeroCopyPacketParser.MAGIC_BYTE:\n            raise ValueError(f\"Invalid packet magic byte: {hex(magic)}\")\n        \n        return magic, length\n\n    @staticmethod\n    def extract_payload(buffer: memoryview, length: int) -> memoryview:\n        \"\"\"Extracts payload zero-copy using memoryview slicing.\"\"\"\n        total_needed = ZeroCopyPacketParser.HEADER_SIZE + length\n        if len(buffer) < total_needed:\n            raise ValueError(\"Incomplete packet buffer\")\n        \n        return buffer[ZeroCopyPacketParser.HEADER_SIZE:total_needed]\n\n    @staticmethod\n    def serialize_packet(msg_type: bytes, payload_bytes: bytes) -> bytes:\n        \"\"\"Helper to construct valid wire format packets for testing/transport.\"\"\"\n        length = len(payload_bytes)\n        header = struct.pack(ZeroCopyPacketParser.HEADER_FORMAT, ZeroCopyPacketParser.MAGIC_BYTE, length)\n        return header + payload_bytes\n"}, {"path": "gossipmesh/p2p/transport.py", "content": "import asyncio\nimport logging\nfrom typing import Optional, Callable, Awaitable\nfrom gossipmesh.p2p.parser import ZeroCopyPacketParser\n\nlogger = logging.getLogger(__name__)\n\nclass TransportReader:\n    \"\"\"Low-level socket transport reader utilizing zero-copy buffer parsing.\"\"\"\n    \n    def __init__(self, reader: asyncio.StreamReader, on_message: Callable[[memoryview], Awaitable[None]]) -> None:\n        self.reader = reader\n        self.on_message = on_message\n        self._buffer = bytearray()\n\n    async def start_reading(self) -> None:\n        \"\"\"Reads incoming stream data and dispatches parsed packets with zero allocations.\"\"\"\n        try:\n            while True:\n                chunk = await self.reader.read(4096)\n                if not chunk:\n                    break\n                self._buffer.extend(chunk)\n                await self._process_buffer()\n        except Exception as e:\n            logger.error(f\"Transport reader error: {e}\")\n            raise\n\n    async def _process_buffer(self) -> None:\n        \"\"\"Processes internal bytearray buffer via memoryviews.\"\"\"\n        mv = memoryview(self._buffer)\n        offset = 0\n        \n        try:\n            while len(mv) - offset >= ZeroCopyPacketParser.HEADER_SIZE:\n                sub_mv = mv[offset:]\n                magic, length = ZeroCopyPacketParser.parse_header(sub_mv)\n                total_packet_size = ZeroCopyPacketParser.HEADER_SIZE + length\n                \n                if len(sub_mv) < total_packet_size:\n                    break  \n                \n                payload_mv = sub_mv[ZeroCopyPacketParser.HEADER_SIZE:total_packet_size]\n                await self.on_message(payload_mv)\n                offset += total_packet_size\n        finally:\n            if offset > 0:\n                del self._buffer[:offset]\n"}, {"path": "tests/test_transport_parser.py", "content": "import asyncio\nimport unittest\nfrom gossipmesh.p2p.parser import ZeroCopyPacketParser\nfrom gossipmesh.p2p.transport import TransportReader\n\nclass TestTransportAndParser(unittest.TestCase):\n\n    def test_parser_header_valid(self):\n        packet = ZeroCopyPacketParser.serialize_packet(b'X', b'hello world')\n        mv = memoryview(packet)\n        magic, length = ZeroCopyPacketParser.parse_header(mv)\n        self.assertEqual(magic, ZeroCopyPacketParser.MAGIC_BYTE)\n        self.assertEqual(length, len(b'hello world'))\n\n    def test_parser_header_invalid_magic(self):\n        bad_packet = b'\\x99\\x00\\x00\\x00\\x05data'\n        mv = memoryview(bad_packet)\n        with self.assertRaises(ValueError):\n            ZeroCopyPacketParser.parse_header(mv)\n\n    def test_parser_header_too_short(self):\n        short_packet = b'\\x47\\x00'\n        mv = memoryview(short_packet)\n        with self.assertRaises(ValueError):\n            ZeroCopyPacketParser.parse_header(mv)\n\n    def test_extract_payload(self):\n        payload_data = b'test-payload'\n        packet = ZeroCopyPacketParser.serialize_packet(b'T', payload_data)\n        mv = memoryview(packet)\n        _, length = ZeroCopyPacketParser.parse_header(mv)\n        payload = ZeroCopyPacketParser.extract_payload(mv, length)\n        self.assertEqual(bytes(payload), payload_data)\n        self.assertIsInstance(payload, memoryview)\n\n    def test_transport_reader_dispatch(self):\n        async def run():\n            packet = ZeroCopyPacketParser.serialize_packet(b'A', b'gossip-data')\n            \n            class MockStreamReader:\n                def __init__(self, data):\n                    self.data = data\n                    self.read_called = False\n                async def read(self, n):\n                    if not self.read_called:\n                        self.read_called = True\n                        return self.data\n                    return b''\n\n            received = []\n            async def dummy_callback(mv: memoryview):\n                received.append(bytes(mv))\n\n            stream = MockStreamReader(packet)\n            transport = TransportReader(stream, dummy_callback)\n            await transport.start_reading()\n            \n            self.assertEqual(len(received), 1)\n            self.assertEqual(received[0], b'gossip-data')\n\n        asyncio.run(run())\n\nif __name__ == '__main__':\n    unittest.main()\n"}]}
